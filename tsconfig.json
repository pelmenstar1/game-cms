{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": [
    "eslint.config.js",
    "stylelint.config.js",
    "prettier.config.js",
    "vitest.config.ts",
    "__tests__",
    "scripts",
    "shared"
  ],
  "exclude": ["./node_modules"]
}
