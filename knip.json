{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["knip"],
  "include": [
    "files",
    "exports",
    "types",
    "catalog",
    "unlisted",
    "dependencies",
    "binaries"
  ],
  "ignore": ["packages/ui/src/theme/global.ts"],
  "ignoreDependencies": ["game-cms", "@storybook/*"],
  "storybook": {
    "entry": [
      "packages/*/.storybook/main.ts",
      "packages/*/vite.storybook.config.ts",
      "packages/*/.storybook/preview.tsx",
      "**/*.stories.tsx"
    ]
  },
  "vitest": {
    "config": ["**/vitest.config.ts"],
    "entry": [
      "**/*.{test,btest,e2e-test,outer-loop-test,test-d}.ts",
      "**/fixtures/**/*.{ts,js}"
    ]
  },
  "workspaces": {
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/main.ts",
        "src/bin.ts",
        "src/cms.config.ts",
        "scripts/*/*.ts"
      ],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": ["@game-cms/codegen"]
    },
    "packages/{base,game-plugin}-components": {
      "entry": [
        "src/components/*/{client,controller,core,renderer,types}.{ts,tsx}",
        "src/**/route.tsx",
        "src/i18n/types.ts"
      ],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": ["@game-cms/vite-plugins", "react-router"]
    },
    "packages/dashboard": {
      "entry": [
        "src/app/routes/**/*/route.tsx",
        "src/types/page.ts",
        "lib/index.ts",
        ".storybook/preview.tsx"
      ],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/base-api": {
      "entry": ["src/index.ts", "src/types.ts", "src/routes/**/*.ts"],
      "project": "**/*.{ts,tsx}"
    },
    "packages/entity-checks": {
      "entry": [
        "src/index.ts",
        "src/types.ts",
        "src/client.ts",
        "src/**/route.tsx",
        "src/**/config.client.ts",
        "src/**/entityAccessRenderer.tsx"
      ]
    },
    "packages/base-plugin": {
      "entry": ["src/index.ts", "src/entity/__tests__/fixtures/**/registry.ts"]
    },
    "packages/{base,game}-plugin": {
      "entry": ["src/index.ts", "src/**/*.client.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/types/index.ts"],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": ["sass-embedded"]
    },
    "demo-app": {
      "entry": ["src/cms.config.ts", "src/entities/**/*.ts"]
    },
    "packages/e2e": {
      "entry": ["src/cms.config.ts", "src/globalSetup.ts"]
    }
  }
}
