{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["knip"],
  "include": ["files", "exports", "types", "catalog", "unlisted"],
  "ignore": [
    "**/*.stories.tsx",
    "**/*.{test,btest,e2e-test}.ts",
    "**/.storybook/*.{ts,tsx}",
    "**/vite.storybook.config.ts",
    "packages/ui/src/theme/global.ts"
  ],
  "ignoreFiles": ["e2e/src/cms.config.ts"],
  "workspaces": {
    "packages/*": {
      "entry": ["src/index.ts", "src/bin.ts", "src/cms.config.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/{base,game-plugin}-components": {
      "entry": [
        "src/components/*/{client,controller,core,renderer,types}.{ts,tsx}",
        "src/i18n/types.ts"
      ],
      "project": "src/**/*.{ts,tsx}",
      "ignore": ["src/micro/FileBigPreview/**/*.ts"]
    },
    "packages/dashboard": {
      "entry": ["src/app/routes/**/*/route.tsx", "src/types/page.ts"],
      "project": "**/*.{ts,tsx}"
    },
    "packages/base-api": {
      "entry": ["src/index.ts", "src/types.ts", "src/routes/**/*.ts"],
      "project": "**/*.{ts,tsx}"
    },
    "packages/entity-checks": {
      "entry": ["src/index.ts", "src/types.ts", "src/client.ts"]
    },
    "demo-app": {
      "entry": ["src/cms.config.ts", "src/entities/**/*.ts"]
    }
  }
}
