{
  "name": "@game-cms/monorepo",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "tsx ./scripts/lint.ts",
    "lint:fix": "pnpm lint --fix",
    "prebuild": "pnpm run --filter @game-cms/codegen build && pnpm run -r --parallel prebuild && tsc --build tsconfig.packages.json --declaration",
    "prebuild:watch": "pnpm run -r --parallel prebuild && tsc --build tsconfig.packages.json --declaration --watch",
    "test": "vitest run --project unit",
    "test:outer-loop": "vitest run --project outer-loop",
    "test:browser": "vitest run --project browser",
    "test:build": "tsx ./scripts/testBuild.ts",
    "e2e:test": "pnpm run --filter @game-cms/e2e-runner start",
    "e2e:launch": "tsx ./scripts/e2e.ts",
    "gen:type": "pnpm run -r --parallel gen:type",
    "gen:ts-deps": "tsx ./scripts/tsconfigDeps.ts",
    "clean": "tsx ./scripts/clean.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "64.0.0",
    "game-cms": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "playwright": "1.57.0",
    "postcss": "8.5.8",
    "prettier": "3.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "17.6.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "8.58.0",
    "vitest": "catalog:",
    "vitest-browser-react": "2.1.0"
  },
  "dependencies": {
    "chalk": "catalog:",
    "glob": "catalog:",
    "yaml": "^2.8.3"
  }
}
