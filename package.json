{
  "name": "@game-cms/monorepo",
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "tsx ./scripts/lint.ts",
    "lint:fix": "pnpm lint --fix",
    "typegen": "pnpm run -r typegen",
    "prebuild": "pnpm run --filter @game-cms/ui build && tsc --build tsconfig.packages.json --declaration",
    "prebuild:watch": "pnpm run -filter @game-cms/ui build && tsc --build tsconfig.packages.json --declaration --watch",
    "test": "vitest --run",
    "clean": "tsx ./scripts/clean.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "4.0.15",
    "@vitest/browser-playwright": "^4.0.15",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "62.0.0",
    "playwright": "1.57.0",
    "postcss": "8.5.6",
    "prettier": "3.7.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "16.26.1",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-scss": "6.13.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "8.49.0",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.0.2"
  },
  "dependencies": {
    "glob": "catalog:"
  }
}
