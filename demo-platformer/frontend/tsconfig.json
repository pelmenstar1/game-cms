{
  "compilerOptions": {
    "rootDir": "./src",
    "noEmit": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["DOM", "ESNext"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["./src"],
  "references": [{ "path": "../shared" }]
}
