{
  "name": "@game-cms/ui",
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "scripts": {
    "build": "tsc && pnpm copy-styles",
    "storybook:start": "storybook dev --port 6006",
    "new-component": "tsx ./scripts/newComponent.ts",
    "new-google-icon": "tsx ./scripts/newGoogleIcon.ts",
    "copy-styles": "tsx ./scripts/copyStyles.ts"
  },
  "dependencies": {
    "@game-cms/shared": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "12.1.4",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@game-cms/codegen": "workspace:*",
    "glob": "catalog:",
    "react-router": "catalog:",
    "rollup": "catalog:",
    "sass-embedded": "1.93.2",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./theme/global": {
      "import": "./dist/src/theme/global.scss",
      "types": "./dist/src/theme/global.d.ts"
    },
    "./theme/breakpoints.scss": {
      "import": "./dist/src/theme/_breakpoints.scss"
    }
  }
}
