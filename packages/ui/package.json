{
  "name": "@game-cms/ui",
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm copy-styles",
    "build": "tsc",
    "storybook:start": "storybook dev --port 6006",
    "new-component": "tsx ./scripts/newComponent.ts",
    "new-google-icon": "tsx ./scripts/newGoogleIcon.ts",
    "copy-styles": "tsx ./scripts/copyStyles.ts",
    "generate-rexports": "tsx ./scripts/generateReExports.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "1.7.7",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "1.1.0",
    "@atlaskit/pragmatic-drag-and-drop-live-region": "1.3.1",
    "@game-cms/shared": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@game-cms/codegen": "workspace:*",
    "@game-cms/storybook-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react-router": "catalog:",
    "sass-embedded": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./theme/global": {
      "import": "./dist/src/theme/global.scss",
      "types": "./dist/src/theme/global.d.ts"
    },
    "./theme/breakpoints.scss": {
      "import": "./dist/src/theme/_breakpoints.scss"
    }
  }
}
