{
  "name": "@game-cms/ui",
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm copy-styles",
    "build": "tsc",
    "storybook:start": "storybook dev --port 6006",
    "new-component": "tsx ./scripts/newComponent.ts",
    "new-google-icon": "tsx ./scripts/newGoogleIcon.ts",
    "copy-styles": "tsx ./scripts/copyStyles.ts",
    "generate-reexports": "tsx ./scripts/generateReExports.ts",
    "test:build": "storybook build"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.0.0",
    "@game-cms/shared": "workspace:*",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-code-block-lowlight": "^3.27.1",
    "@tiptap/extension-document": "^3.27.1",
    "@tiptap/extension-paragraph": "^3.27.1",
    "@tiptap/extension-text": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-zoom-pan-pinch": "catalog:"
  },
  "devDependencies": {
    "@game-cms/codegen": "workspace:*",
    "@game-cms/storybook-config": "workspace:*",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@types/hast": "^3.0.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-router": "catalog:",
    "sass-embedded": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./types": {
      "import": "./dist/src/types/index.js",
      "types": "./dist/src/types/index.d.ts"
    },
    "./theme/global": {
      "import": "./dist/src/theme/global.scss",
      "types": "./dist/src/theme/global.d.ts"
    },
    "./theme/breakpoints.scss": {
      "import": "./dist/src/theme/_breakpoints.scss"
    }
  }
}
