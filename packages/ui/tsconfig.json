{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": [],
    "declaration": true,
    "allowJs": true,
    "strict": true,
    "jsx": "react-jsx",
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "composite": true,
    "verbatimModuleSyntax": true,
    "paths": { "#storybook/*": ["./.storybook/*"] }
  },
  "references": [
    { "path": "../codegen" },
    { "path": "../shared" },
    { "path": "../storybook-config" }
  ],
  "include": ["src", "scripts", ".storybook/main.ts", ".storybook/preview.tsx"]
}
