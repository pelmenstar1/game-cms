{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*",
    ".storybook/preview.tsx"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": [
      "node",
      "vite/client",
      "@game-cms/base-api/clientTypes",
      "@game-cms/base-components"
    ],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "#storybook/*": ["./.storybook/*"] },
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "composite": true
  },
  "references": [
    { "path": "../base-api" },
    { "path": "../base-components" },
    { "path": "../base-core" },
    { "path": "../client" },
    { "path": "../codegen" },
    { "path": "../component-api" },
    { "path": "../core" },
    { "path": "../global" },
    { "path": "../ignition" },
    { "path": "../shared" },
    { "path": "../storybook-config" },
    { "path": "../ui" },
    { "path": "../vite-plugins" }
  ]
}
