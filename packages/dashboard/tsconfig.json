{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*",
    ".storybook/preview.tsx"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client", "@game-cms/base-api/clientTypes"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "#storybook/*": ["./.storybook/*"]
    },
    "noEmit": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "composite": true
  },
  "references": [
    { "path": "../build" },
    { "path": "../client" },
    { "path": "../react" },
    { "path": "../shared" },
    { "path": "../types" },
    { "path": "../ui" },
    { "path": "../utils" },
    { "path": "../base-api" },
    { "path": "../base-types" },
    { "path": "../vite-plugins" },
    { "path": "../base-utils" },
    { "path": "../codegen" },
    { "path": "../conditional" }
  ]
}
