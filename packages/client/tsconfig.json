{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "types": ["@game-cms/api/clientTypes"],

    "declaration": true,
    "noUncheckedIndexedAccess": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["./src"],
  "references": [
    { "path": "../types" },
    { "path": "../api" },
    { "path": "../conditional" },
    { "path": "../shared" },
    { "path": "../shared-api" }
  ]
}
