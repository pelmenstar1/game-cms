{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "composite": true
  },
  "include": ["./src"],
  "references": [
    { "path": "../types" },
    { "path": "../api" },
    { "path": "../components" },
    { "path": "../env" },
    { "path": "../react" },
    { "path": "../shared" },
    { "path": "../shared-api" }
  ]
}
