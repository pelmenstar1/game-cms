{
  "name": "@game-cms/core",
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fastify": "catalog:",
