{
  "name": "@game-cms/base-components",
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@game-cms/types": "workspace:*",
    "@game-cms/ui": "workspace:*",
    "@game-cms/utils": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@game-cms/build": "workspace:*",
    "@game-cms/vite-plugins": "workspace:*",
    "@rollup/plugin-commonjs": "20.0.0",
    "@rollup/plugin-replace": "6.0.3",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "5.1.2",
    "glob": "13.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "4.5.4"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./source": {
      "import": "./dist/source.js",
      "types": "./src/source.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./vite-manifest.json": {
      "import": "./dist/.vite/manifest.json"
    }
  }
}
