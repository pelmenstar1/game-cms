{
  "name": "@game-cms/base-components",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "scripts": {
    "prebuild": "tsx ./scripts/copyStyles.ts",
    "new-component": "tsx ./scripts/newComponent.ts",
    "build": "tsc",
    "storybook:start": "storybook dev --port 6006"
  },
  "dependencies": {
    "@game-cms/base-core": "workspace:*",
    "@game-cms/component-api": "workspace:*",
    "@game-cms/conditional": "workspace:*",
    "@game-cms/core": "workspace:*",
    "@game-cms/global": "workspace:*",
    "@game-cms/shared": "workspace:*",
    "@game-cms/ui": "workspace:*",
    "@xyflow/react": "^12.10.1",
    "i18next": "catalog:",
    "mongodb": "catalog:",
    "react-i18next": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@game-cms/base-api": "workspace:*",
    "@game-cms/codegen": "workspace:*",
    "@game-cms/component-testing-lib": "workspace:*",
    "@game-cms/storybook-config": "workspace:*",
    "@game-cms/vite-plugins": "workspace:*",
    "@types/node": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-links": "catalog:",
    "react-router": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js"
    },
    "./shared": {
      "import": "./dist/src/shared.js",
      "types": "./dist/src/shared.d.ts"
    },
    "./dashboard": {
      "import": "./dist/src/dashboard/index.js",
      "types": "./dist/src/dashboard/index.d.ts"
    },
    "./routes": {
      "import": "./dist/src/routes/index.js",
      "types": "./dist/src/routes/index.d.ts"
    }
  }
}
