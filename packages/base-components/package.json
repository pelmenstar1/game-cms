{
  "name": "@game-cms/base-components",
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "scripts": {
    "build": " vite build --outDir dist/client && vite build --ssr src/index.ts --outDir dist/node"
  },
  "dependencies": {
    "@game-cms/types": "workspace:*",
    "@game-cms/ui": "workspace:*",
    "@game-cms/utils": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@game-cms/build": "workspace:*",
    "@game-cms/vite-plugins": "workspace:*",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-replace": "6.0.3",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "glob": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "4.5.4"
  },
  "exports": {
    ".": {
      "import": "./dist/node/index.js",
      "types": "./dist/node/index.d.ts"
    },
    "./source": {
      "import": "./dist/node/source.js",
      "types": "./src/node/source.d.ts"
    },
    "./types": {
      "import": "./dist/node/types.js",
      "types": "./dist/node/types.d.ts"
    }
  },
  "browserslist": [
    "since 2020-01-01"
  ]
}
