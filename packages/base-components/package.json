{
  "name": "@game-cms/base-components",
  "packageManager": "yarn@4.10.3",
  "type": "module",
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@game-cms/types": "workspace:*",
    "@game-cms/ui": "workspace:*",
    "@game-cms/utils": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@game-cms/build": "workspace:*",
    "@game-cms/vite-plugins": "workspace:*",
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-replace": "6.0.2",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "5.0.4",
    "glob": "11.0.3",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plugin-dts": "4.5.4"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./source": {
      "import": "./dist/source.js",
      "types": "./src/source.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./vite-manifest.json": {
      "import": "./dist/.vite/manifest.json"
    }
  }
}
