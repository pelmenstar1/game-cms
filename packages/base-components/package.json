{
  "name": "@game-cms/base-components",
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "scripts": {
    "prebuild": "tsx ./scripts/copyStyles.ts",
    "new-component": "tsx ./scripts/newComponent.ts",
    "build": "tsc",
    "storybook:start": "storybook dev --port 6006"
  },
  "dependencies": {
    "@game-cms/base-core": "workspace:*",
    "@game-cms/client": "workspace:*",
    "@game-cms/codegen": "workspace:*",
    "@game-cms/component-api": "workspace:*",
    "@game-cms/conditional": "workspace:*",
    "@game-cms/core": "workspace:*",
    "@game-cms/global": "workspace:*",
    "@game-cms/shared": "workspace:*",
    "@game-cms/ui": "workspace:*",
    "i18next": "catalog:",
    "mongodb": "catalog:",
    "react-i18next": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@game-cms/base-api": "workspace:*",
    "@game-cms/codegen": "workspace:*",
    "@game-cms/storybook-config": "workspace:*",
    "@game-cms/vite-plugins": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "mongodb": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./micro": {
      "import": "./dist/src/micro/index.js",
      "types": "./dist/src/micro/index.d.ts"
    }
  },
  "browserslist": [
    "since 2020-01-01"
  ]
}
