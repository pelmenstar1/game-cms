{
  "extends": "../../configs/tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "./dist",
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "@game-cms/base-api/types"],
    "paths": { "#storybook/*": ["./.storybook/*"] }
  },
  "references": [
    { "path": "../base-api" },
    { "path": "../base-core" },
    { "path": "../client" },
    { "path": "../codegen" },
    { "path": "../codegen" },
    { "path": "../component-api" },
    { "path": "../component-testing-lib" },
    { "path": "../conditional" },
    { "path": "../core" },
    { "path": "../global" },
    { "path": "../shared" },
    { "path": "../storybook-config" },
    { "path": "../ui" },
    { "path": "../vite-plugins" }
  ],
  "include": [
    "./src",
    "./scripts",
    "./src/**/*.json",
    "./.storybook/preview.tsx",
    "./.storybook/main.ts"
  ],
  "exclude": ["./scripts"]
}
