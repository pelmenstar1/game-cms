{
  "extends": "../../configs/tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "@game-cms/base-api/types"]
  },
  "references": [
    { "path": "../base-api" },
    { "path": "../base-core" },
    { "path": "../client" },
    { "path": "../codegen" },
    { "path": "../codegen" },
    { "path": "../component-api" },
    { "path": "../conditional" },
    { "path": "../core" },
    { "path": "../global" },
    { "path": "../shared" },
    { "path": "../ui" }
  ],
  "include": ["./src", "./scripts", "./src/**/*.json"],
  "exclude": ["./scripts"]
}
