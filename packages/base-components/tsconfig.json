{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": ["node", "vite/client"],

    "declaration": true,

    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": true
  },
  "references": [
    { "path": "../build" },
    { "path": "../types" },
    { "path": "../ui" },
    { "path": "../utils" },
    { "path": "../vite-plugins" }
  ],
  "include": ["./src", "./scripts"]
}
