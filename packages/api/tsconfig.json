{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "esnext",
    "types": ["node", "@game-cms/shared/types"],

    "declaration": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["./src"],
  "references": [
    { "path": "../build" },
    { "path": "../codegen" },
    { "path": "../conditional" },
    { "path": "../env" },
    { "path": "../shared" },
    { "path": "../shared-api" },
    { "path": "../types" }
  ]
}
