{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",

    "declaration": true,
    "noUncheckedIndexedAccess": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["./src"],
  "references": [
    { "path": "../types" },
    { "path": "../base-types" },
    { "path": "../shared" },
    { "path": "../base-api" },
    { "path": "../base-components" }
  ]
}
